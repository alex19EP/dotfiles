{
  "env": {
    "ENABLE_TOOL_SEARCH": "auto:5",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
{{- if eq .chezmoi.os "windows" }}
    "CLAUDE_CODE_USE_POWERSHELL_TOOL": "1",
{{- end }}
    "CLAUDE_CODE_PLUGIN_DIRS": "~/.local/share/claude-mods/ask-preview-text"
  },
  "permissions": {
    "allow": [
      "Bash(git:*)",
      "Edit(src/**)",
      "Bash(firecrawl:*)",
      "Bash(npx firecrawl-cli:*)"
    ],
    "deny": [
      "Read(.env*)",
      "Bash(rm -rf:*)",
      "WebSearch",
      "WebFetch"
    ],
    "defaultMode": "auto"
  },
  "enableAllProjectMcpServers": true,
  "worktree": {
    "baseRef": "head"
  },
  "statusLine": {
    "type": "command",
{{- if eq .chezmoi.os "windows" }}
    "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"{{ .chezmoi.homeDir | replace "\\" "/" }}/.claude/statusline.ps1\""
{{- else }}
    "command": "{{ .chezmoi.homeDir }}/.claude/statusline.sh"
{{- end }}
  },
  "enabledPlugins": {
    "context7@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "clangd-lsp@claude-plugins-official": true,
    "csharp-lsp@claude-plugins-official": true,
{{- /* Machine-local directory marketplaces, only wired up where they exist */}}
{{- $localPlugins := joinPath .chezmoi.homeDir ".claude" "local-plugins" }}
{{- $waLocal := joinPath .chezmoi.homeDir ".claude" "local-marketplaces" "wa-local" }}
{{- if stat $localPlugins }}
    "lua-lsp@claude-plugins-official": false,
    "emmylua-lsp@local-plugins": true,
{{- else }}
    "lua-lsp@claude-plugins-official": true,
{{- end }}
    "rust-analyzer-lsp@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "jdtls-lsp@claude-plugins-official": true,
    "claude-code-setup@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true,
    "firecrawl@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": true,
    "zig-lsp@zircote-lsp": true,
    "cc-plugin-you-should-know@builtin": true,
    "cc-plugin-diff@builtin": false,
    "cc-plugin-telemetry@builtin": false
  },
  "extraKnownMarketplaces": {
    "zircote-lsp": {
      "source": {
        "source": "github",
        "repo": "zircote/lsp-marketplace"
      }
{{- if stat $waLocal }}
    },
    "wa-local": {
      "source": {
        "source": "directory",
        "path": {{ $waLocal | toJson }}
      }
{{- end }}
{{- if stat $localPlugins }}
    },
    "local-plugins": {
      "source": {
        "source": "directory",
        "path": {{ $localPlugins | toJson }}
      }
{{- end }}
    }
  },
  "language": "english",
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true
  },
  "feedbackDrafts": "notify",
  "spinnerTipsEnabled": false,
  "alwaysThinkingEnabled": true,
  "effortLevel": "xhigh",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "high"
    }
  },
  "pluginConfigs": {
    "cc-plugin-agents-md@builtin": {
      "options": {
        "instructionFiles": "claude-md-and-agents-md"
      }
    }
  },
  "autoUpdatesChannel": "latest",
  "plansDirectory": "./docs/plans",
  "tui": "fullscreen",
  "prefersReducedMotion": true,
  "showThinkingSummaries": true,
  "skipWorkflowUsageWarning": true,
  "theme": "auto",
  "editorMode": "normal",
  "verbose": false,
  "preferredNotifChannel": "terminal_bell",
  "switchModelsOnFlag": false,
  "autoScrollEnabled": true,
  "showTurnDuration": true,
  "terminalProgressBarEnabled": true,
  "teammateMode": "auto",
  "remoteControlAtStartup": false,
  "crossSessionInbound": "accept",
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "voiceEnabled": true,
  "network": {
    "allowAllUnixSockets": true
  }
}
